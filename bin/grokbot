#!/bin/sh
# Runs the plugin with Node 22+ (the hub's systemd PATH is short: look where node usually is).
dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for n in "$PERSONA_NODE" "$(command -v node 2>/dev/null)" "$HOME/.local/bin/node" "$HOME/.npm-global/bin/node" \
         /usr/local/bin/node /usr/bin/node /opt/homebrew/bin/node "$HOME"/.nvm/versions/node/*/bin/node; do
  [ -n "$n" ] && [ -x "$n" ] || continue
  major=$("$n" -p 'process.versions.node.split(".")[0]' 2>/dev/null) || continue
  [ "${major:-0}" -ge 22 ] && exec "$n" "$dir/src/main.mjs" "$@"
done
echo "grokbot: needs Node.js 22 or newer (set PERSONA_NODE to its path)" >&2
exit 1
