{
  "manifest_version": 1,
  "id": "grokbot",
  "name": "Grok Bot",
  "version": "0.1.0",
  "description": "把 Grok Bot 的对话放进 Agents 页：看对话、发消息，回复实时推到手机，不经 Open Lark 轮询。",
  "publisher": "rome-xi",
  "homepage": "https://github.com/rome-xi/persona-grokbot",
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": "bin/grokbot"
  },
  "activation_events": ["on_startup"],
  "contributes": {
    "agent_sources": [
      {"id": "grokbot", "name": "Grok Bot", "providers": ["grok_bot"]}
    ]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "watch_sessions": {"type": "integer", "title": "同时实时监听的会话数", "description": "最近活跃的几个会话保持实时连接，其余的按列表刷新", "default": 6, "minimum": 1, "maximum": 20},
      "include_team_agents": {"type": "boolean", "title": "包括团队里的 Bot", "default": false}
    }
  },
  "secrets": [
    {"name": "access_token", "title": "Grok Bot 登录凭据", "description": "在插件页点「登录 Grok Bot」获取，或填 Grok Bot 桌面客户端的 access token", "required": true}
  ],
  "permissions": {"network": ["api2.cursor.sh"]}
}
